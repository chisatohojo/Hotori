{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Hotori: Build hardware test",
      "type": "process",
      "command": "${env:USERPROFILE}/.platformio/penv/Scripts/pio.exe",
      "args": ["run", "-e", "nano_new"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Hotori: Upload hardware test",
      "type": "process",
      "command": "${env:USERPROFILE}/.platformio/penv/Scripts/pio.exe",
      "args": ["run", "-e", "nano_new", "-t", "upload", "--upload-port", "${input:serialPort}"],
      "problemMatcher": []
    },
    {
      "label": "Hotori: List boards",
      "type": "process",
      "command": "${env:USERPROFILE}/.platformio/penv/Scripts/pio.exe",
      "args": ["device", "list"],
      "problemMatcher": []
    },
    {
      "label": "Hotori: Serial monitor (115200)",
      "type": "process",
      "command": "${env:USERPROFILE}/.platformio/penv/Scripts/pio.exe",
      "args": ["device", "monitor", "-e", "nano_new", "--port", "${input:serialPort}"],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "serialPort",
      "type": "promptString",
      "description": "Enter the Nano port from 'Hotori: List boards' (for example COM5)"
    }
  ]
}
